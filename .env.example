# Copy this file to .env.local and fill in real values.
# Next.js loads .env.local automatically. Do not commit .env.local.

# MongoDB connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/sudhaga?retryWrites=true&w=majority

# JWT used for login cookies
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ImageKit — https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Public site URL (used by the browser for absolute links if needed)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Admin — from the service account JSON. Server only. Never expose the private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase web app — Project settings → Your apps → SDK setup
# Enable Authentication → Sign-in method → Google, and allow localhost.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
